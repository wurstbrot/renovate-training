{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["maven", "dockerfile", "gradle", "gradle-wrapper"],
  "labels": ["dependencies"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "vulnerabilityFixStrategy": "highest"
  },
  "packageRules": [
    {
      "description": "Maven-Updates kennzeichnen",
      "matchManagers": ["maven"],
      "addLabels": ["maven"]
    },
    {
      "description": "Docker-Updates kennzeichnen",
      "matchManagers": ["dockerfile"],
      "addLabels": ["docker"]
    },
    {
      "description": "Android-Updates (Gradle) kennzeichnen",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "addLabels": ["android"]
    },
    {
      "description": "Java-Basis-Image: Minor-, Patch- und Digest-Updates automatisch mergen",
      "matchDatasources": ["docker"],
      "matchDepNames": ["eclipse-temurin"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "addLabels": ["automerge"]
    },
    {
      "description": "Sicherheitsnetz: Major-Updates werden nie automatisch gemerged",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
